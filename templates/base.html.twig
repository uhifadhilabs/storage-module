{# Bundle base: the host's shell plus the Files hub's own stylesheet. Every page
   of this bundle extends this instead of the host layout directly, so the hub's
   vocabulary loads only where the hub renders — the host's own stylesheet never
   references storage.

   Symfony docs — https://symfony.com/doc/current/frontend/asset_mapper.html :
   "All bundles that have a Resources/public/ or public/ directory will
   automatically have that directory added as an asset path, using the namespace:
   bundles/<BundleName>" — and under AssetMapper those assets are automatically
   content-versioned. So public/files.css is served as
   bundles/uhifadhilabsstorage/files.css with a digest, no assets:install. #}
{% extends 'layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/uhifadhilabsstorage/files.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# The hub's behaviour: the filter row, the shape toggle and the file overlay.
       Plain DOM, no framework — a module bundle must not make a host install a
       Stimulus controller before somebody can look at a photograph. #}
    <script src="{{ asset('bundles/uhifadhilabsstorage/files.js') }}" defer></script>
{% endblock %}

{# The host layout expects each page to supply its own `.page` container. #}
{% block content %}
    <div class="page">
        {% block storage_page %}{% endblock %}
    </div>
{% endblock %}

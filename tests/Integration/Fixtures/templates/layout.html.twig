{# The HOST's shell, stubbed. Any uhifadhi instance provides layout.html.twig;
   this bundle's pages extend it, so the suite needs one that offers the same four
   blocks and nothing else. Deliberately bare: a stub that grew a sidebar would
   start testing the stub. #}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{% block title %}uhifadhi{% endblock %}</title>
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% block content %}{% endblock %}
{% block javascripts %}{% endblock %}
</body>
</html>